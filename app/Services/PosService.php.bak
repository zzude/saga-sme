<?php

namespace App\Services;

use App\Models\PosSession;
use App\Models\PosTransaction;
use App\Models\PosTransactionItem;
use App\Models\Item;
use App\Models\Account;
use App\Models\JournalHeader;
use App\Models\JournalLine;
use Illuminate\Support\Facades\DB;

class PosService
{
    // -------------------------------------------------------------------------
    // Open POS Session
    // -------------------------------------------------------------------------
    public function openSession(float $openingCash = 0): PosSession
    {
        $companyId = auth()->user()->company_id;

        // Check no open session already
        $existing = PosSession::where('company_id', $companyId)
            ->where('user_id', auth()->id())
            ->where('status', 'open')
            ->first();

        if ($existing) {
            return $existing;
        }

        return PosSession::create([
            'company_id'   => $companyId,
            'user_id'      => auth()->id(),
            'opened_at'    => now(),
            'opening_cash' => $openingCash,
            'status'       => 'open',
        ]);
    }

    // -------------------------------------------------------------------------
    // Close POS Session
    // -------------------------------------------------------------------------
    public function closeSession(PosSession $session, float $closingCash = 0): PosSession
    {
        $session->update([
            'status'       => 'closed',
            'closed_at'    => now(),
            'closing_cash' => $closingCash,
        ]);
        return $session;
    }

    // -------------------------------------------------------------------------
    // Process Sale
    // -------------------------------------------------------------------------
    public function processSale(
        PosSession $session,
        array $cartItems,
        string $paymentMethod,
        float $amountTendered,
        ?string $customerName = null,
        ?string $notes = null
    ): PosTransaction {

        return DB::transaction(function () use ($session, $cartItems, $paymentMethod, $amountTendered, $customerName, $notes) {

            $companyId = auth()->user()->company_id;

            // Calculate totals
            $subtotal       = 0;
            $discountAmount = 0;
            $taxAmount      = 0;

            foreach ($cartItems as $cartItem) {
                $gross    = round((float)$cartItem['quantity'] * (float)$cartItem['unit_price'], 2);
                $disc     = round($gross * ((float)($cartItem['discount_percent'] ?? 0) / 100), 2);
                $net      = $gross - $disc;
                $sst      = ($cartItem['is_sst_applicable'] ?? false)
                    ? round($net * ((float)($cartItem['sst_rate'] ?? 8) / 100), 2)
                    : 0;

                $subtotal       += $gross;
                $discountAmount += $disc;
                $taxAmount      += $sst;
            }

            $totalAmount  = round($subtotal - $discountAmount + $taxAmount, 2);
            $changeAmount = round($amountTendered - $totalAmount, 2);

            // Create transaction
            $transaction = PosTransaction::create([
                'company_id'      => $companyId,
                'session_id'      => $session->id,
                'transaction_no'  => PosTransaction::generateTransactionNo(),
                'subtotal'        => $subtotal,
                'discount_amount' => $discountAmount,
                'tax_amount'      => $taxAmount,
                'total_amount'    => $totalAmount,
                'payment_method'  => $paymentMethod,
                'amount_tendered' => $amountTendered,
                'change_amount'   => max(0, $changeAmount),
                'customer_name'   => $customerName,
                'notes'           => $notes,
                'status'          => 'completed',
                'created_by'      => auth()->id(),
            ]);

            // Create transaction items + deduct stock
            foreach ($cartItems as $cartItem) {
                PosTransactionItem::create([
                    'transaction_id'    => $transaction->id,
                    'item_id'           => $cartItem['item_id'] ?? null,
                    'description'       => $cartItem['description'],
                    'quantity'          => $cartItem['quantity'],
                    'unit_price'        => $cartItem['unit_price'],
                    'discount_percent'  => $cartItem['discount_percent'] ?? 0,
                    'is_sst_applicable' => $cartItem['is_sst_applicable'] ?? false,
                    'sst_rate'          => $cartItem['sst_rate'] ?? 8,
                ]);

                // Deduct stock if item tracks inventory
                if (!empty($cartItem['item_id'])) {
                    $item = Item::withoutGlobalScope('company')->find($cartItem['item_id']);
                    if ($item && $item->track_inventory) {
                        $item->adjustStock(
                            'out',
                            (float) $cartItem['quantity'],
                            (float) $cartItem['unit_price'],
                            PosTransaction::class,
                            $transaction->id,
                            $transaction->transaction_no
                        );
                    }
                }
            }

            // Post journal
            $journal = $this->postSaleJournal($transaction, $companyId, $paymentMethod);
            $transaction->update(['journal_id' => $journal->id]);

            // Update session totals
            $session->increment('total_transactions');
            $session->increment('total_sales', $totalAmount);

            return $transaction;
        });
    }

    // -------------------------------------------------------------------------
    // Void Transaction
    // -------------------------------------------------------------------------
    public function voidTransaction(PosTransaction $transaction, string $reason): PosTransaction
    {
        if ($transaction->status === 'voided') {
            throw new \RuntimeException('Transaksi ini sudah dibatalkan.');
        }

        return DB::transaction(function () use ($transaction, $reason) {

            // Restore stock
            foreach ($transaction->items as $item) {
                if ($item->item_id) {
                    $stockItem = Item::withoutGlobalScope('company')->find($item->item_id);
                    if ($stockItem && $stockItem->track_inventory) {
                        $stockItem->adjustStock(
                            'in',
                            (float) $item->quantity,
                            (float) $item->unit_price,
                            PosTransaction::class,
                            $transaction->id,
                            'VOID-' . $transaction->transaction_no
                        );
                    }
                }
            }

            // Post reversal journal
            if ($transaction->journal_id) {
                $this->postVoidJournal($transaction);
            }

            $transaction->update([
                'status'      => 'voided',
                'voided_by'   => auth()->id(),
                'voided_at'   => now(),
                'void_reason' => $reason,
            ]);

            // Update session totals
            $transaction->session->decrement('total_transactions');
            $transaction->session->decrement('total_sales', $transaction->total_amount);

            return $transaction;
        });
    }

    // -------------------------------------------------------------------------
    // Get active session for current user
    // -------------------------------------------------------------------------
    public function getActiveSession(): ?PosSession
    {
        return PosSession::where('company_id', auth()->user()->company_id)
            ->where('user_id', auth()->id())
            ->where('status', 'open')
            ->latest()
            ->first();
    }

    // =========================================================================
    // PRIVATE — Journal helpers
    // =========================================================================
    private function postSaleJournal(PosTransaction $transaction, int $companyId, string $paymentMethod): JournalHeader
    {
        $journal = JournalHeader::create([
            'company_id'  => $companyId,
            'type'        => 'POS',
            'date'        => now()->toDateString(),
            'description' => "POS Sale: {$transaction->transaction_no}",
            'status'      => 'posted',
            'posted_at'   => now(),
            'created_by'  => auth()->id(),
        ]);

        // DR — payment account
        $debitAccountCode = match ($paymentMethod) {
            'cash'   => '1200',  // Cash on Hand
            'card'   => '1100',  // Bank (card settlements)
            'qr'     => '1100',  // Bank (QR settlements)
            default  => '1200',
        };

        $debitAccountId = Account::where('company_id', $companyId)
            ->where('code', $debitAccountCode)->value('id');

        JournalLine::create([
            'company_id'    => $companyId,
            'journal_id'    => $journal->id,
            'account_id'    => $debitAccountId,
            'description'   => "POS: {$transaction->transaction_no}",
            'debit'         => $transaction->total_amount,
            'credit'        => 0,
            'base_debit'    => $transaction->total_amount,
            'base_credit'   => 0,
            'currency_code' => 'MYR',
            'exchange_rate' => 1,
        ]);

        // CR — Sales Revenue (4100)
        $salesAccountId = Account::where('company_id', $companyId)
            ->where('code', '4100')->value('id');

        $netSales = $transaction->total_amount - $transaction->tax_amount;

        JournalLine::create([
            'company_id'    => $companyId,
            'journal_id'    => $journal->id,
            'account_id'    => $salesAccountId,
            'description'   => "POS Sales: {$transaction->transaction_no}",
            'debit'         => 0,
            'credit'        => $netSales,
            'base_debit'    => 0,
            'base_credit'   => $netSales,
            'currency_code' => 'MYR',
            'exchange_rate' => 1,
        ]);

        // CR — SST Payable (2300) if applicable
        if ($transaction->tax_amount > 0) {
            $sstAccountId = Account::where('company_id', $companyId)
                ->where('code', '2300')->value('id');

            JournalLine::create([
                'company_id'    => $companyId,
                'journal_id'    => $journal->id,
                'account_id'    => $sstAccountId,
                'description'   => "SST: {$transaction->transaction_no}",
                'debit'         => 0,
                'credit'        => $transaction->tax_amount,
                'base_debit'    => 0,
                'base_credit'   => $transaction->tax_amount,
                'currency_code' => 'MYR',
                'exchange_rate' => 1,
            ]);
        }

        return $journal;
    }

    private function postVoidJournal(PosTransaction $transaction): void
    {
        // Simple reversal — swap DR/CR of original journal
        $original = $transaction->journal;
        if (!$original) return;

        $companyId = auth()->user()->company_id;

        $reversal = JournalHeader::create([
            'company_id'  => $companyId,
            'type'        => 'POS',
            'date'        => now()->toDateString(),
            'description' => "VOID POS: {$transaction->transaction_no}",
            'status'      => 'posted',
            'posted_at'   => now(),
            'created_by'  => auth()->id(),
        ]);

        foreach ($original->lines as $line) {
            JournalLine::create([
                'company_id'    => $companyId,
                'journal_id'    => $reversal->id,
                'account_id'    => $line->account_id,
                'description'   => 'VOID: ' . $line->description,
                'debit'         => $line->credit,
                'credit'        => $line->debit,
                'base_debit'    => $line->base_credit,
                'base_credit'   => $line->base_debit,
                'currency_code' => 'MYR',
                'exchange_rate' => 1,
            ]);
        }
    }
}